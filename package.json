{
  "name": "zhixu",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-monaco.mjs",
    "predev": "npm run build -w zhixu-algo-viz",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run build -w zhixu-algo-viz",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "npm run build -w zhixu-algo-viz && tsc --noEmit",
    "pretest:algorithms": "npm run build -w zhixu-algo-viz",
    "test:algorithms": "node --test tests/algorithm-traces.test.mjs tests/additional-traces.test.mjs",
    "test:e2e": "playwright test",
    "pretest:demo-code": "npm run build -w zhixu-algo-viz",
    "test:demo-code": "node scripts/verify-demo-code.mjs",
    "prebuild:demo": "npm run build -w zhixu-algo-viz",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "zhixu-algo-viz": "*",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0"
  }
}
